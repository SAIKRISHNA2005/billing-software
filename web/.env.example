# Google Apps Script Web App Deployment URL (ending in /exec)
APPS_SCRIPT_EXEC_URL="https://script.google.com/macros/s/YOUR_SCRIPT_DEPLOYMENT_ID/exec"

# Shared Secret Header (must match SHARED_SECRET in Apps Script Properties)
APPS_SCRIPT_SHARED_SECRET="replace_with_a_secure_random_shared_secret_string"

# Session Cookie Configuration
SESSION_COOKIE_NAME="tms_session"

# Application Environment
NODE_ENV="development"

# Default Timezone
TZ="Asia/Kolkata"
